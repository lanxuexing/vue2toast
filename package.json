{
  "name": "@lanxuexing/vue2toast",
  "version": "0.0.7",
  "description": "A lightweight, high-performance Toast notification plugin for Vue 3, built with TypeScript.",
  "main": "dist/vue2toast.umd.js",
  "module": "dist/vue2toast.es.js",
  "types": "dist/index.d.ts",
  "author": "lanxuexing",
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "dev": "vite serve --config vite.config.demo.mjs",
    "build": "vite build --config vite.config.js",
    "build:demo": "vite build --config vite.config.demo.mjs",
    "preview": "vite preview"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-toast",
    "toast",
    "notification",
    "message",
    "alert",
    "popup",
    "component",
    "plugin",
    "typescript",
    "ts"
  ],
  "dependencies": {},
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "highlight.js": "^11.11.1",
    "sass": "^1.83.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "overrides": {
    "minimatch": "^9.0.5"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue2toast.es.js",
      "require": "./dist/vue2toast.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lanxuexing/vue2toast.git"
  },
  "bugs": {
    "url": "https://github.com/lanxuexing/vue2toast/issues",
    "email": "geziaihuahua@163.com"
  },
  "homepage": "https://github.com/lanxuexing/vue2toast#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}